# KILAJO Environment Variables Template

# Supabase Public Configuration (Required for client and public access)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Server Service Role (Required for privileged operations, webhook validation, and background sync)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Application Settings
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="KILAJO"

# Bridge & Integrations (MT4/MT5/cTrader Webhook Secret for HMAC verification)
BRIDGE_WEBHOOK_SECRET=your-bridge-hmac-secret-at-least-32-chars

# Storage Bucket Names
NEXT_PUBLIC_SCREENSHOTS_BUCKET=trade-screenshots
NEXT_PUBLIC_IMPORTS_BUCKET=raw-imports
